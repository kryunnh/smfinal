<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.mapper.krhCommentMapper">

	<!--요리 고민방 댓글 목록 조회-->
	<select id="commentList" parameterType="String" resultType="krhCommentVO">
		select * from comment where boardId=#{boardId} and replyId=0 order by createdAt asc
	</select>
	
	<!--요리 고민방 대댓글 목록 조회-->
	<select id="commentListReply" parameterType="krhCommentVO" resultType="krhCommentVO"> 
		select * from comment where boardId=#{boardId} and replyId=#{commentId} order by createdAt asc
	</select>
	
	<!--요리 고민방 댓글 갯수 -->
	<select id="commentNumberOfReplies" parameterType="krhCommentVO" resultType="int">
		select count(commentId) from comment where replyId=#{replyId} order by createdAt asc 
	</select>
	
