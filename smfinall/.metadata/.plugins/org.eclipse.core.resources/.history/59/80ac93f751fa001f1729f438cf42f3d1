<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.mapper.krhMainMapper">
	<!--인기 레시피 조회(receipes db에서 갖고오기)-->
	<select id="popularRecipe" resultType="com.project.model.Recipes">
		select foodName, recipesId, foodImg from recipes order by views asc limit 4
	</select>
	
	<!--최신 레시피 조회-->
	<select id="recentRecipe" resultType="com.project.model.Recipes">
		select foodName, recipesId, foodImg from recipes order by recipesId asc limit 4
	</select>
	
	<!-- 사용자의 관심 목록에서 가장 많이 등장한 카테고리의 레시피 추천 -->
	<select id="getRecommendedRecipes" resultType="com.project.model.Recipes">
	    SELECT r.recipesId, r.foodName, r.foodImg
	    FROM recipes r
	    WHERE r.categoryId = (
	        SELECT categoryId
	        FROM favorites f
	        JOIN recipes r2 ON f.recipeId = r2.recipesId
	        WHERE f.userId = #{id}
	        GROUP BY r2.categoryId
	        ORDER BY COUNT(*) DESC
	        LIMIT 1
	    )
	    ORDER BY RAND()
	    LIMIT 4;
	</select>
</mapper>
