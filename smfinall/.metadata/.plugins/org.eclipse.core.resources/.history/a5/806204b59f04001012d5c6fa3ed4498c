<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.mapper.krhUserRecipeMapper">
	<!--레시피 테이블 추가-->
	<!-- 레시피 테이블 추가 -->
	<insert id="insertUserRecipe" useGeneratedKeys="true" keyProperty="userRecipesId" parameterType="com.project.model.UserRecipe">
		insert into User_Recipes(foodName, foodImg, step1, step2, step3, step4, step5, step6,
		stepImg1, stepImg2, stepImg3, stepImg4, stepImg5, stepImg6, user_id, foodTime, category_id)
		values (#{foodName}, #{foodImg}, #{step1}, #{step2}, #{step3}, #{step4}, #{step5}, #{step6},
		#{stepImg1}, #{stepImg2}, #{stepImg3}, #{stepImg4}, #{stepImg5}, #{stepImg6}, #{userId}, #{foodTime}, #{categoryId})
	</insert>

	<!-- 재료 테이블 추가 (이미 존재하면 추가 안 함) -->
	<insert id="insertIngredientsIfNotExist" parameterType="List">
	    <!-- 재료가 없으면 삽입, 있으면 넘어감 -->
	    <foreach collection="list" item="ingredient" separator=" UNION ALL ">
	        INSERT INTO Ingredients(name)
	        VALUES (#{ingredient})
	        ON DUPLICATE KEY UPDATE name = name;
	    </foreach>
	</insert>
	
	<!-- 레시피-재료 관계 테이블 추가 -->
	<insert id="linkUserRecipeIngredient" parameterType="List">
	    <foreach collection="list" item="ingredient" separator=",">
	        insert into Recipe_Ingredients(user_recipes_id, ingredient_id)
	        values (#{userRecipesId}, (SELECT ingredient_id FROM Ingredients WHERE name = #{ingredient}));
	    </foreach>
	</insert>

</mapper>