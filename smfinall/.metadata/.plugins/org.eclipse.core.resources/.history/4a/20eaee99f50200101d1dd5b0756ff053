	//태그에 맞는 클럽 조회
	@GetMapping("/tags/{tagId}")
	public ResponseEntity<List<krhClubVO>>getClubsByTag(@PathVariable int tagId){
		System.out.println("Received tagId: " + tagId);  // 서버에서 tagId 확인
