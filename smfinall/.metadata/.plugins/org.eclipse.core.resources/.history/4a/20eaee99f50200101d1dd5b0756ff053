	//검색어에 따른 클럽 검색
	@GetMapping("/search")
	public ResponseEntity<List<krhClubVO>>searchClub(@RequestParam String keyword){
		return ResponseEntity.ok(krhclubService.searchClub(keyword));
	}
	
	//클럽 추가
	@PostMapping("/create")
	@PostMapping("/create")
	public ResponseEntity<String> createClub(@RequestBody KrhClubVO krhclubVO, @RequestHeader("Authorization") String token, @RequestParam(value = "image", required = false) MultipartFile imageFile) {
	    String jwtToken = token.startsWith("Bearer ") ? token.substring(7) : token;
	    String email;
	    try {
	        email = jwtUtil.extractEmail(jwtToken);  // JwtUtil에서 이메일을 추출
	    } catch (Exception e) {
	        return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("유효하지 않은 토큰입니다.");
	    }

	    // 이메일이 정상적으로 추출되지 않았을 경우 예외 처리
	    if (email == null || email.isEmpty()) {
	        return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("로그인이 필요합니다.");
	    }

	    // 이메일로 사용자 조회
	    User user = userService.findByUserEmail(email);
	    
	    // 사용자가 존재하지 않을 경우 예외 처리
	    if (user == null) {
	        return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("사용자 정보를 찾을 수 없습니다.");
	    }

	    // 클럽 필수 필드 검증
	    if (krhclubVO.getClubName() == null || krhclubVO.getClubName().isEmpty()) {
	        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("동호회 이름을 입력해주세요.");
	    }
	    if (krhclubVO.getLocation() == null || krhclubVO.getLocation().isEmpty()) {
	        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("모임 장소를 입력해주세요.");
	    }

	    // recruiterEmail 설정 후 서비스 호출
	    krhclubVO.setRecruiterEmail(email);

	    // 이미지 업로드 처리 (필요한 경우)
	    if (imageFile != null && !imageFile.isEmpty()) {
	        try {
	            // UUID로 파일 이름 고유화
	            String fileName = UUID.randomUUID().toString() + "_" + StringUtils.cleanPath(imageFile.getOriginalFilename());
	            Path targetLocation = Paths.get(uploadDir, fileName);
	            
	            // 디렉터리 생성 (존재하지 않으면)
	            Files.createDirectories(targetLocation.getParent());
	            
	            // 파일 저장
	            Files.copy(imageFile.getInputStream(), targetLocation, StandardCopyOption.REPLACE_EXISTING);
	            System.out.println("파일이 성공적으로 저장되었습니다: " + targetLocation.toString());
	        } catch (IOException e) {
	            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("파일 저장 중 오류가 발생했습니다.");
	        }
	    }

	    // 클럽 생성
	    try {
	        krhclubService.createClub(krhclubVO);
	        return ResponseEntity.ok("모임이 성공적으로 등록되었습니다.");
	    } catch (Exception e) {
	        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("모임 등록 실패. 서버 오류가 발생했습니다.");
	    }
	}
	
	//클럽 단건조회
	@GetMapping("/{clubId}")
	public ResponseEntity<krhClubVO> getClubById(@PathVariable int clubId){
		krhclubService.getClubById(clubId);
		return ResponseEntity.ok(krhclubService.getClubById(clubId));
	}
	
	//클럽 신청을 위한 주최자의 이메일 갖고오기
	@PostMapping("/{clubId}/send-application")
	public ResponseEntity<String> sendApplication(@PathVariable int clubId, @RequestBody krhApplicationRequestVO apvo){
		// 요청 객체에 clubId 설정
        apvo.setClubId(clubId);
        apvo.setApplyDate(java.time.LocalDateTime.now()); //신청일자
        
        // 게시글(동호회) 작성자의 이메일 가져오기
        String ownerEmail = krhclubService.getEmailbyId(clubId);

        if (ownerEmail == null) {
            return ResponseEntity.badRequest().body("해당 동호회 정보를 찾을 수 없습니다.");
        }

        // 신청 데이터 저장
        krhclubService.insertApplication(apvo);
        // 이메일 전송
        sendEmail(ownerEmail, apvo);

        return ResponseEntity.ok("신청이 완료되었습니다!");
    }

    // 이메일 보내기
    private void sendEmail(String ownerEmail, krhApplicationRequestVO apvo) {
        SimpleMailMessage message = new SimpleMailMessage();
        message.setTo(ownerEmail);
        message.setSubject("[냠냠] 회원님의 모임에 새로운 신청이 도착했습니다!");
        message.setText(
        		"신청자 정보"+"\n\n\n" +
                "이름: " + apvo.getApplicantName() + "\n" +
                "이메일: " + apvo.getApplicantEmail() + "\n" +
                "나이: " + apvo.getApplicantAge() + "\n" +
                "성별: " + apvo.getApplicantGender() + "\n" +
                "신청 일자: " + apvo.getApplyDate()
        );
        mailSender.send(message);
    }
}