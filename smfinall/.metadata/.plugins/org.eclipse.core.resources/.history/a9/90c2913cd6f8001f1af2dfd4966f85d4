package com.project.service;

import java.util.List;

import org.apache.ibatis.annotations.Param;

import com.project.model.krhClubVO;
import com.project.model.krhTagVO;

public interface krhClubService {
	
	//클럽 전체 목록 조회
	List<krhClubVO> clubList();
	
	//태그 10개 목록
	List<krhTagVO> tagList();
	
	//태그에 맞는 클럽 조회
	List<krhClubVO> clubtagList(int tagId);
	
	//검색어에 따른 클럽 검색
	List<krhClubVO> searchClub(String keyword);
	
	
	// 동호회 생성
    public void createClub(krhClubVO club) {
        clubMapper.insertClub(club); // 동호회 삽입
    }

    // 동호회에 태그 추가
    public void addTagToClub(int clubId, krhTagVO tag) {
        // 태그 삽입
        tagMapper.insertTag(tag);

        // 동호회와 태그 관계 삽입 (club_tag 테이블)
        ClubTagVO clubTag = new ClubTagVO();
        clubTag.setClubId(clubId);
        clubTag.setTagId(tag.getTagId());
        clubMapper.insertClubTag(clubTag); // 동호회-태그 관계 삽입
    }
}
