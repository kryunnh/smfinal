package com.project.controller;

import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.server.ResponseStatusException;

import com.project.model.krhBoardVO;
import com.project.model.krhReportVO;
import com.project.service.krhBoardService;

import jakarta.servlet.http.HttpSession;

@RestController
@RequestMapping("/api/board")
public class krhBoardController {
	
	@Autowired
	private krhBoardService krhboardService;
	
	//목록 조회 + 페이징 + 검색
	@GetMapping
    public ResponseEntity<Map<String, Object>> getBoardList(
        @RequestParam(value = "page", defaultValue = "1") int page,
        @RequestParam(value = "size", defaultValue = "10") int size,
        @RequestParam(value = "findStr", defaultValue = "") String findStr) {

        // 서비스에서 게시글 목록과 전체 게시글 수 가져오기
        Map<String, Object> result = krhboardService.getBoardList(page, size, findStr);

        // 반환
        return new ResponseEntity<>(result, HttpStatus.OK);
    }
	
	//상세보기
	@GetMapping("/{boardId}")
	public krhBoardVO getBoardById(@PathVariable int boardId) {
		krhboardService.incrementViews(boardId); //조회수 상승
		return krhboardService.getBoardById(boardId);
	}

	//삭제하기
	@DeleteMapping("/{boardId}")
	public void deleteBoard(@PathVariable int boardId, HttpSession session) {
		try {
	        // 세션에서 사용자 ID 가져오기 (int로 변경)
	        Integer loggedInUserId = (Integer) session.getAttribute("id");

	        // 로그인 확인
	        if (loggedInUserId == null) {
	            throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "로그인이 필요합니다.");
	        }

	        // 게시글 작성자 조회
	        Integer authorId = krhboardService.getAuthorIdByBoardId(boardId);

	        // 작성자만 삭제 가능
	        if (authorId == null || !authorId.equals(loggedInUserId)) {
	            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "삭제 권한이 없습니다.");
	        }
	       
	        // 게시글 삭제 처리
	        krhboardService.deleteBoard(boardId);
	        
	    } catch (Exception e) {
	        // 상세 오류 메시지를 추가하거나, 필요시 log 추가
	        throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "오류 발생", e);
	    }
	}
	
	//글 추가하기
	@PostMapping
	public void insertBoard(@RequestBody krhBoardVO krhboardVo, HttpSession session) {
		// 세션에서 로그인한 사용자 아이디 가져오기
        Integer loggedInUserId = (Integer) session.getAttribute("id");
        String loggedInName = (String) session.getAttribute("name");
        if (loggedInUserId == null && loggedInName==null) {
            return;
        }

		krhboardVo.setAuthor(loggedInName); // 작성자 이름 자동 설정
		krhboardVo.setAuthorId(loggedInUserId); //작성자 아이디
		
		krhboardService.insertBoard(krhboardVo);
	}
	
	//수정하기
    @PutMapping("/{boardId}")
    public void updateBoard(@RequestBody krhBoardVO krhboardVo, HttpSession session, @PathVariable int boardId) {
    	try {
	        // 세션에서 사용자 ID 가져오기 (int로 변경)
	        Integer loggedInUserId = (Integer) session.getAttribute("id");

	        // 로그인 확인
	        if (loggedInUserId == null) {
	            throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "로그인이 필요합니다.");
	        }

	        // 게시글 작성자 조회
	        Integer authorId = krhboardService.getAuthorIdByBoardId(boardId);

	        // 작성자만 삭제 가능
	        if (authorId == null || !authorId.equals(loggedInUserId)) {
	            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "수정 권한이 없습니다.");
	        }
	        
	        // 게시글 수정 처리
	        krhboardService.updateBoard(krhboardVo);
	        
	    } catch (Exception e) {
	        // 상세 오류 메시지를 추가하거나, 필요시 log 추가
	        throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "오류 발생", e);
	    }
    }
    
    //신고하기
    @PostMapping("/{boardId}/report")
    public ResponseEntity<String> reportBoard(
            @PathVariable int boardId,
            @RequestBody krhReportVO report,
            HttpSession session) {
        try {
            // 세션에서 신고한 사용자 ID 가져오기
            Integer reporterId = (Integer) session.getAttribute("id");

            if (reporterId == null) {
                return new ResponseEntity<>("로그인이 필요합니다.", HttpStatus.UNAUTHORIZED);
            }

            // 신고 정보를 설정
            report.setBoardId(boardId);
            report.setReporterId(reporterId);

            // 신고 처리
            krhboardService.reportBoard(report);

            return new ResponseEntity<>("게시물 신고가 완료되었습니다.", HttpStatus.OK);

        } catch (Exception e) {
            return new ResponseEntity<>("신고 처리 중 오류가 발생했습니다.", HttpStatus.INTERNAL_SERVER_ERROR);
        }
    }
}
