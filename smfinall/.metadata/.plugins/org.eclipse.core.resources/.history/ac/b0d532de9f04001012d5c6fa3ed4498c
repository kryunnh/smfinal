<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.mapper.krhUserRecipeMapper">
    <!-- 레시피 추가 -->
    <insert id="insertUserRecipe" parameterType="com.project.model.UserRecipe">
        INSERT INTO user_recipe (food_name, food_time, foodImg, category_id, user_id, step1, step2, step3, step4, step5, step6, step_img1, step_img2, step_img3, step_img4, step_img5, step_img6)
        VALUES (#{foodName}, #{foodTime}, #{categoryId}, #{foodImg}, #{userId}, #{step1}, #{step2}, #{step3}, #{step4}, #{step5}, #{step6}, #{stepImg1}, #{stepImg2}, #{stepImg3}, #{stepImg4}, #{stepImg5}, #{stepImg6})
    </insert>

    <!-- 재료 추가 -->
    <insert id="insertIngredients" parameterType="java.util.List">
        <foreach collection="ingredients" item="ingredient" separator=",">
            INSERT INTO ingredients (ingredient_name) VALUES (#{ingredient})
        </foreach>
    </insert>

    <!-- 재료-레시피 관계 추가 -->
    <insert id="insertRecipeIngredient" parameterType="map">
        INSERT INTO recipe_ingredient (user_recipes_id, ingredient_id)
        VALUES (#(userRecipesId}, #{ingredientId})
    </insert>
    
        <!-- 3. 재료 ID 조회 -->
    <select id="getIngredientIdByName" parameterType="String" resultType="long">
        SELECT ingredient_id
        FROM ingredients
        WHERE ingredient_name = #{ingredientName}
    </select>
    
</mapper>