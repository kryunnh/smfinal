<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.mapper.krhMainMapper">
	<!--인기 레시피 조회(receipes db에서 갖고오기)-->
	<select id="popularRecipe" resultType="krhMainVo">
		select foodName, recipesId as recipesId, foodImg from recipes order by views asc limit 4
	</select>	
	<!--최신 레시피 조회-->
	<select id="recentRecipe" resultType="krhMainVo">
		select foodName, recipesId as recipesId, foodImg from recipes order by recipesId asc limit 4
	</select>
	
	<!-- 사용자의 관심 목록에서 가장 많이 등장한 카테고리의 레시피 추천 -->
	<select id="getRecommendedRecipes" resultType="krhMainVO">
	    SELECT r.recipesId, r.foodName, r.foodImg 
	    FROM recipes r
	    WHERE r.categoryId = (
	        SELECT categoryId 
	        FROM (
	            SELECT r.categoryId, COUNT(*) AS count 
	            FROM favorites f
	            JOIN recipes r ON f.recipeId = r.recipesId
	            WHERE f.userId = #{id}
	            GROUP BY r.categoryId
	            ORDER BY count DESC
	            LIMIT 1
	        ) AS topCategory
	    )
	    ORDER BY RAND()
	    LIMIT 4;
	</select>

	<!--날씨 기반 레시피 추천 목록 조회-->
	
	
	<!--요리 고민방 목록 총 게시글 갯수(검색 포함) -->
	<select id="countBoard" resultType="int">
		select count(*) from board
		<where>
			<if test="findStr != null and findStr !=''">
				title like concat('%',#{findStr},'%')
			</if>
		</where>
	</select>
		
	<!-- 요리 고민방 페이징 후 게시글 조회(검색 포함) -->
	<select id="getBoardList" resultType="krhBoardVO">
		SELECT * FROM board
		<where>
			<if test="findStr != null and findStr !=''">
				title like concat('%',#{findStr},'%')
			</if>
		</where>
	    ORDER BY createdAt DESC
	    LIMIT #{start}, #{size}
	</select>
	
	<!--요리 고민방 목록 단건 상세 조회 -->
	<select id="getBoardById" parameterType="int" resultType="krhBoardVO">
		select * from board
		where boardId=#{boardId}
	</select>
	
	<!--요리 고민방 조회수 -->
	<update id="incrementViews" parameterType="int">
		update board set views=views+1 where boardId=#{boardId}
	</update>
	
	<!--요리 고민방 단건 수정-->
	<update id="updateBoard" parameterType="krhBoardVO">
		update board set title=#{title}, content=#{content} where boardId=#{boardId}
	</update>
	
	<!--요리 고민방 단건 추가 -->
	<insert id="insertBoard" parameterType="krhBoardVO">
		insert into board(title, author, authorId, content,createdAt) values (#{title}, #{author}, #{authorId], #{content}, now())
	</insert>
	
	<!--요리 고민방 단건 삭제 -->
	<select id="getAuthorIdByBoardId" resultType="int">
		select authorId from board where boardId=#{boardId}
	</select>
	
	<delete id="deleteBoard" parameterType="int">
		delete from board where boardId=#{boardId}
	</delete>
	
	<!--요리 고민방 신고하기-->
	<insert id="reportBoard" parameterType="krhReportVO">
		insert into reports(boardId, reporterId, reporter, reason, description, reportedAt) values(#{boardId}, #{reporterId}, #{reporter}, #{reason}, #{description}, now())
	</insert>
	
	<!-- 유저의 좋아요 상태 확인 -->
	<select id="getLikeStatus" resultType="String">
		select likeType from boardLike where boardId=#{boardId} and userId=#{id}
	</select>
	
	<!-- 좋아요/싫어요 상태 업데이트 -->
	<update id="updateLikeStauts">
		insert into boardLike(boardId, userId, likeType) values(#{boardId}, #{id}, #{status})
		on duplicate key update likeType=#{status}
	</update>
	
	<!-- 좋아요 갯수 -->
	<select id="getLikeCount" resultType="int">
		select count(*) from boardLike where boardId=#{boardId} and likeType='like'
	</select>
	
	<!-- 싫어요 갯수 -->
	<select id="getDislikeCount" resultType="int">
		select count(*) from boardLike where boardId=#{boardId} and likeType='dislike'
	</select>
	
	<!--요리 고민방 댓글 목록 조회-->
	<select id="commentList" parameterType="String" resultType="krhCommentVO">
		select * from comment where boardId=#{boardId} and replyId=0 order by createdAt asc
	</select>
	
	<!--요리 고민방 대댓글 목록 조회-->
	<select id="commentListReply" parameterType="krhCommentVO" resultType="krhCommentVO"> 
		select * from comment where boardId=#{boardId} and replyId=#{commentId} order by createdAt asc
	</select>
	
	<!--요리 고민방 댓글 갯수 -->
	<select id="commentNumberOfReplies" parameterType="krhCommentVO" resultType="int">
		select count(commentId) from comment where replyId=#{replyId} order by createdAt asc 
	</select>
	
	<!--요리 고민방 댓글 추가 -->
	
	<!--요리 고민방 댓글 수정 -->
	
	<!--요리 고민방 댓글 삭제 -->
	
</mapper>
