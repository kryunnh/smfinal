package com.project.controller;

import java.util.List;

import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

import com.project.model.Ingredients;
import com.project.model.UserRecipe;
import com.project.service.RecipesService;


@CrossOrigin(origins = "http://localhost:5173")
@RestController
public class ljmUserRecipeController {
	
	private RecipesService recipesService;
	
	
	
	@GetMapping("/api/userrecipe")
	public List<UserRecipe> getUserRecipes(){
		List<UserRecipe> userRecipe = userRecipesService.getAllUserRecipes();
		for(UserRecipe userRecipes : userRecipe) {
			List<Ingredients> ingredients = recipesService.getIngredientsByUserRecipeId(userRecipe.getUserRecipesId());
			userRecipes.setIngredients(ingredients);
		}
		return userRecipe;
	}
	
}
