package com.project.controller;

import java.io.File;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;

import com.project.model.UserRecipes;
import com.project.service.RecipesService;

import io.jsonwebtoken.io.IOException;

@RestController
@CrossOrigin(origins = "https://localhost.5173")
public class ChallengeController {
	
	private static final String UPLOAD_DIR ="upload/";

	@Autowired
	private RecipesService recipesService;
	
	@PostMapping("/api/upload")
	public String uploadFile(@RequestParam("file") MultipartFile file,
            @RequestParam("foodName") String foodName,
            @RequestParam("step1") String step1,
            @RequestParam("step2") String step2,
            @RequestParam("step3") String step3,
            @RequestParam("step4") String step4,
            @RequestParam("step5") String step5,
            @RequestParam("step6") String step6,
            @RequestParam("stepImg1") String stepImg1,
            @RequestParam("stepImg2") String stepImg2,
            @RequestParam("stepImg3") String stepImg3,
            @RequestParam("stepImg4") String stepImg4,
            @RequestParam("stepImg5") String stepImg5,
            @RequestParam("stepImg6") String stepImg6,
            @RequestParam("foodTime") Integer foodTime,
            @RequestParam("categoryId") Integer categoryId,
            @RequestParam("usersId") Long usersId) {
		try {
			File uploadDir = new File(UPLOAD_DIR);
			if(!uploadDir.exists()) {
				uploadDir.mkdirs();
			}
		Path filePath = Paths.get(UPLOAD_DIR + file.getOriginalFilename());
		Path path = Paths.get(filePath);
		Files.write(filePath, file.getBytes());
		
		UserRecipes userrecipe = new UserRecipes();
		userrecipe.setFoodName(foodName);
		userrecipe.setFoodImg(filePath); // 파일 경로 저장
		userrecipe.setStep1(step1);
		userrecipe.setStep2(step2);
		userrecipe.setStep3(step3);
		userrecipe.setStep4(step4);
		userrecipe.setStep5(step5);
		userrecipe.setStep6(step6);
		userrecipe.setStepImg1(stepImg1);
		userrecipe.setStepImg2(stepImg2);
		userrecipe.setStepImg3(stepImg3);
		userrecipe.setStepImg4(stepImg4);
		userrecipe.setStepImg5(stepImg5);
		userrecipe.setStepImg6(stepImg6);
		userrecipe.setFoodTime(foodTime);
		userrecipe.setCategoryId(categoryId);
		userrecipe.setUsersId(usersId);

		return "성공";
	}catch(IOException e) {
		e.printStackTrace();
		return "실패";
	}
	
}
