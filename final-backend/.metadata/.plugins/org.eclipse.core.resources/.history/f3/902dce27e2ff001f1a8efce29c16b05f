package com.project.mapper;

import java.util.List;

import org.apache.ibatis.annotations.Delete;
import org.apache.ibatis.annotations.Insert;
import org.apache.ibatis.annotations.Param;
import org.apache.ibatis.annotations.Select;
import org.apache.ibatis.annotations.Update;

import com.project.model.Review;

public interface ReviewMapper {
	
	@Select("SELECT r.*,  u.* FROM Reviews r JOIN user u ON r.user_id = u.id " +
	        "WHERE r.recipes_id = #{id} ORDER BY r.created_at DESC")
	List<Review> getAllReview(@Param("id") long id);
	
	@Insert("INSERT INTO Reviews (recipes_id, user_id, review_text, rating, created_at, updated_at) " +
	        "VALUES (#{recipesId}, #{usersId}, #{reviewText}, #{rating}, NOW(), NOW())")
	void insertReview(Review review);
	
	@Update("UPDATE Reviews SET review_text = #{reviewText}, rating = #{rating}, updated_at = NOW() WHERE id = #{reviewId}")
    void putReview(Review review);
    
	@Delete("DELETE FROM Reviews WHERE id = #{id}")
    void deleteReview(@Param("id") long id);
    
	@Select("SELECT r.*, u.* FROM Reviews r LEFT JOIN User u ON r.user_id = u.id " +
	        "WHERE r.reviewId = #{reviewId}")
	Review getReviewById(@Param("reviewId") long reviewId);

	
}
