import org.apache.http.entity.ContentType;
import org.apache.http.entity.mime.MultipartEntityBuilder;
import org.apache.http.impl.client.HttpClients;
import org.apache.http.impl.client.CloseableHttpClient;
import org.apache.http.impl.client.HttpResponseException;
import org.apache.http.client.methods.HttpPost;
import org.apache.http.HttpResponse;
import org.apache.http.util.EntityUtils;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.client.HttpClientErrorException;
import org.springframework.web.client.RestTemplate;

import java.io.IOException;
import java.io.InputStream;
import java.util.Base64;
import org.springframework.beans.factory.annotation.Value;

@Service
public class NaverCloudSpeechService {

    @Value("${clova.api.url}")
    private String clovaApiUrl;

    @Value("${clova.api.secret}")
    private String apiSecret;

    @Value("${clova.api.clientId}")
    private String clientId;

    public String recognizeSpeech(MultipartFile audioFile) throws IOException {
        try (CloseableHttpClient client = HttpClients.createDefault()) {
            HttpPost post = new HttpPost(clovaApiUrl);
            
            MultipartEntityBuilder builder = MultipartEntityBuilder.create();
            builder.addBinaryBody("file", audioFile.getInputStream(), ContentType.DEFAULT_BINARY, audioFile.getOriginalFilename());
            
            // 헤더 추가
            post.setHeader("X-Naver-Client-Id", clientId);
            post.setHeader("X-Naver-Client-Secret", apiSecret);

            post.setEntity(builder.build());

            HttpResponse response = client.execute(post);

            int statusCode = response.getStatusLine().getStatusCode();
            if (statusCode != 200) {
                throw new HttpResponseException(statusCode, "API 호출 오류");
            }

            String result = EntityUtils.toString(response.getEntity());
            // 응답으로 받은 텍스트 반환
            return result; // JSON 형태의 음성 텍스트 결과
        } catch (IOException e) {
            e.printStackTrace();
            throw new IOException("네이버 클로바 음성 인식 호출 실패", e);
        }
    }
}
