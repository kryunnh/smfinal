package com.project.mapper;

import com.project.model.Inquiry;
import com.project.model.Recipe;
import com.project.model.User;
import org.apache.ibatis.annotations.*;

import java.util.List;

@Mapper
public interface UserMapper {

    // 🔹 유저 정보 조회 (본인)
    @Select("SELECT * FROM users WHERE id = #{id}")
    User getUserById(Long id);

    // 🔹 유저 정보 수정 (본인)
    @Update("UPDATE users SET email=#{email}, name=#{name}, profile_image=#{profileImage} WHERE id=#{id}")
    void updateUser(User user);
    
    // 🔹 회원탈퇴 요청 저장
    @Insert("INSERT INTO deletion_requests (email, reason, request_date) VALUES (#{email}, #{reason}, NOW())")
    void requestAccountDeletion(@Param("email") String email, @Param("reason") String reason);

    // 🔹 특정 유저 조회
    @Select("SELECT * FROM users WHERE email = #{email}")
    User getUserByEmail(String email);
    // 🔹 유저 알림 목록 조회 (본인)
    @Select("SELECT * FROM notifications WHERE user_id = #{userId}")
    List<String> getNotifications(Long userId);

    // 🔹 유저 알림 읽음 처리 (본인)
    @Update("UPDATE notifications SET read_status = 1 WHERE id = #{id}")
    void markNotificationAsRead(Long id);

    // 🔹 관심 레시피 조회 (본인)
    @Select("SELECT * FROM wishlist WHERE user_id = #{userId}")
    List<Recipe> getWishlist(Long userId);

    // 🔹 관심 레시피 삭제 (본인)
    @Delete("DELETE FROM wishlist WHERE id = #{id}")
    void removeWishlist(Long id);

    // 🔹 1:1 문의 목록 조회 (본인)
    @Select("SELECT * FROM inquiries WHERE user_id = #{userId}")
    List<Inquiry> getUserInquiries(Long userId);
    
    // 🔹 1:1 문의 삭제 (본인)
    @Delete("DELETE FROM inquiries WHERE id = #{id} AND user_id = #{userId}")
    void deleteUserInquiry(@Param("id") Long id, @Param("userId") Long userId);
}
