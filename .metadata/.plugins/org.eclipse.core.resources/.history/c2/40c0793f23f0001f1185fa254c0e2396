package com.project.mapper;

import com.project.model.Notification;
import org.apache.ibatis.annotations.*;

import java.util.List;

@Mapper
public interface NotificationMapper {

    @Select("SELECT * FROM notifications WHERE user_id = #{userId}")
    List<Notification> getUserNotifications(Long userId);

    @Insert("INSERT INTO notifications(user_id, message, is_read) VALUES(#{userId}, #{message}, #{isRead})")
    void insertNotification(Notification notification);

    @Update("UPDATE notifications SET is_read=true WHERE id=#{id}")
    void markNotificationAsRead(Long id);
}
