package com.project.mapper;

import com.project.model.Inquiry;
import com.project.model.Recipe;
import com.project.model.User;
import org.apache.ibatis.annotations.*;

import java.util.List;

@Mapper
public interface UserMapper {

    // 🔹 회원가입
    @Insert("INSERT INTO users (email, password, name, profile_image, role) VALUES (#{email}, #{password}, #{name}, #{profileImage}, #{role})")
    @Options(useGeneratedKeys = true, keyProperty = "id")
    void registerUser(User user);

    // 🔹 로그인
    @Select("SELECT * FROM users WHERE email = #{email} AND password = #{password}")
    User login(User user);

    // 🔹 유저 정보 조회 (본인)
    @Select("SELECT * FROM users WHERE id = #{id}")
    User getUserById(Long id);

    // 🔹 유저 정보 수정 (본인)
    @Update("UPDATE users SET email=#{email}, name=#{name}, profile_image=#{profileImage} WHERE id=#{id}")
    void updateUser(User user);

    // 🔹 유저 삭제
    @Delete("DELETE FROM users WHERE email = #{email}")
    void deleteUser(String email);
}
