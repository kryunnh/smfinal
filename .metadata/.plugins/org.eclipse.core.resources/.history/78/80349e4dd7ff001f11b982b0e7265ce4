package com.project.model;

import com.fasterxml.jackson.annotation.JsonProperty;

import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@NoArgsConstructor
@AllArgsConstructor
public class User {
    private Long id;
    private String email;
    private String password;
    private String name;
    private String phoneNumber;
    private String profileImage;
    private String role = "USER";
    @JsonProperty("isVerified")  // ✅ JSON의 "isVerified"와 매핑 강제
    private Boolean isVerified = false;  // ✅ 기본값 false 설정
    // ✅ Getter 수정 (null 방지)
    public Boolean getIsVerified() {
        return isVerified != null ? isVerified : false;
    }

    // ✅ Setter 추가
    public void setIsVerified(Boolean isVerified) {
        this.isVerified = isVerified;
    }

    // ✅ 생성자 추가 (에러 해결)
    public User(String email, String password, String name, String phoneNumber, String profileImage) {
        this.email = email;
        this.password = password;
        this.name = name;
        this.phoneNumber = phoneNumber;
        this.profileImage = profileImage;
        this.role = "USER";
        this.isVerified = false;
    }
}
