package com.project.service;

import com.project.mapper.TarotMapper;
import com.project.model.Recipe;
import com.project.model.TarotCard;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import java.util.List;

@Service
@RequiredArgsConstructor
public class TarotService {

    private final TarotMapper tarotMapper;
    private final RecipeService recipeService; // ✅ RecipeService 추가

    // ✅ 4장의 랜덤 타로 카드 가져오기
    public List<TarotCard> getRandomTarotCards(int count) {
        return tarotMapper.getRandomTarotCards(count);
    }

    // ✅ 타로 카드 선택한 기록 저장
    public void saveSelectedTarot(String email, int tarotCardId) {
        tarotMapper.insertTarotSelection(email, tarotCardId);
    }

    // ✅ 랜덤 레시피 가져오기
    public Recipe getRandomRecipe() {
        return recipeService.getRandomRecipe(); // RecipeService에서 랜덤 레시피 가져오기
    }
}
