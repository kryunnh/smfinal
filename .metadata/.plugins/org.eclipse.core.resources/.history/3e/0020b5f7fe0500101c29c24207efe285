    /** ✅ 일반 레시피 (Recipes) 관리 **/
    /** ✅ 1. 모든 레시피 가져오기 */
    @Service
    public class RecipeService {

        private final AdminMapper adminMapper;
        private final FileStorageService fileStorageService;

        public RecipeService(AdminMapper adminMapper, FileStorageService fileStorageService) {
            this.adminMapper = adminMapper;
            this.fileStorageService = fileStorageService;
        }

        /** ✅ 1. 모든 레시피 가져오기 */
        public List<Recipe> getAllRecipes() {
            return adminMapper.getAllRecipes();
        }

        /** ✅ 2. 특정 레시피 조회 (재료 포함) */
        public Recipe getRecipeById(Long recipeId) {
            Recipe recipe = adminMapper.getRecipeById(recipeId);
            if (recipe == null) {
                throw new RuntimeException("❌ 해당 레시피가 존재하지 않습니다.");
            }
            recipe.setIngredients(adminMapper.getIngredientsByRecipeId(recipeId));
            return recipe;
        }

        /** ✅ 3. 레시피 추가 */
        @Transactional
        public void addRecipe(Recipe recipe, MultipartFile foodImg, List<String> steps, 
                              List<MultipartFile> stepImages, int categoryId, int foodTime, 
                              Integer weatherId, List<String> ingredients) {
            
            // ✅ 1. 이미지 저장
            recipe.setFoodImg(handleImageUpdate(foodImg, null));

            // ✅ 2. 기본 정보 저장
            recipe.setCategoryId(categoryId);
            recipe.setFoodTime(foodTime);
            recipe.setWeatherId(weatherId);
            
            // ✅ 3. 레시피 저장
            adminMapper.insertRecipe(recipe);

            // ✅ 4. 단계 및 이미지 저장
            updateRecipeSteps(recipe, steps);
            updateRecipeStepImages(recipe, stepImages, null);

            // ✅ 5. 재료 저장
            updateRecipeIngredients(recipe.getRecipesId(), ingredients);
        }

        /** ✅ 4. 레시피 수정 */
        @Transactional
        public void updateRecipe(Recipe recipe, MultipartFile foodImg, 
                                 List<String> steps, List<MultipartFile> stepImages, 
                                 List<Boolean> deleteStepImages, List<String> ingredients) {

            // ✅ 1. 기존 레시피 확인
            Recipe existingRecipe = adminMapper.getRecipeById(recipe.getRecipesId());
            if (existingRecipe == null) {
                throw new RuntimeException("❌ 레시피 업데이트 실패! 해당 ID가 존재하지 않습니다.");
            }

            // ✅ 2. 대표 이미지 업데이트
            recipe.setFoodImg(handleImageUpdate(foodImg, existingRecipe.getFoodImg()));

            // ✅ 3. 단계 및 이미지 업데이트
            updateRecipeSteps(recipe, steps);
            updateRecipeStepImages(recipe, stepImages, deleteStepImages);

            // ✅ 4. 레시피 정보 업데이트
            adminMapper.updateRecipe(recipe);

            // ✅ 5. 재료 업데이트
            updateRecipeIngredients(recipe.getRecipesId(), ingredients);
        }

        /** ✅ 5. 레시피 삭제 */
        public void deleteRecipe(Long id) {
            adminMapper.deleteRecipe(id);
        }

        /** ✅ 6. 단계별 설명 업데이트 */
        private void updateRecipeSteps(Recipe recipe, List<String> steps) {
            adminMapper.deleteStepsByRecipeId(recipe.getRecipesId()); // 기존 단계 삭제
            for (int i = 0; i < steps.size(); i++) {
                adminMapper.insertStep(recipe.getRecipesId(), i + 1, steps.get(i)); // 새로운 단계 저장
            }
        }

        /** ✅ 7. 단계별 이미지 업데이트 */
        private void updateRecipeStepImages(Recipe recipe, List<MultipartFile> stepImages, List<Boolean> deleteStepImages) {
            List<String> existingImages = adminMapper.getStepImagesByRecipeId(recipe.getRecipesId());

            for (int i = 0; i < existingImages.size(); i++) {
                if (deleteStepImages != null && deleteStepImages.get(i)) {
                    fileStorageService.deleteFile(existingImages.get(i));
                    adminMapper.deleteStepImage(recipe.getRecipesId(), i + 1);
                }
            }

            for (int i = 0; i < stepImages.size(); i++) {
                if (stepImages.get(i) != null && !stepImages.get(i).isEmpty()) {
                    String newImage = fileStorageService.storeFile(stepImages.get(i));
                    adminMapper.updateStepImage(recipe.getRecipesId(), i + 1, newImage);
                }
            }
        }

        /** ✅ 8. 재료 업데이트 */
        private void updateRecipeIngredients(Long recipeId, List<String> ingredients) {
            adminMapper.deleteIngredientsByRecipeId(recipeId);
            for (String ingredientName : ingredients) {
                Integer ingredientId = adminMapper.getIngredientIdByName(ingredientName);
                if (ingredientId == null) {
                    Ingredient newIngredient = new Ingredient();
                    newIngredient.setName(ingredientName);
                    adminMapper.insertNewIngredient(newIngredient);
                    ingredientId = newIngredient.getIngredientId();
                }
                adminMapper.insertRecipeIngredient(recipeId, ingredientId);
            }
        }

        /** ✅ 9. 이미지 저장 및 업데이트 */
        private String handleImageUpdate(MultipartFile file, String existingFileName) {
            if (file != null && !file.isEmpty()) {
                if (existingFileName != null) {
                    fileStorageService.deleteFile(existingFileName);
                }
                return fileStorageService.storeFile(file);
            }
            return existingFileName;
        }
    }

