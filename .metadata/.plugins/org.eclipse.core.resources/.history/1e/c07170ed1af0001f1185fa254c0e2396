package com.project.service;

import java.util.List;
import org.springframework.stereotype.Service;

import com.project.mapper.AdminMapper;
import com.project.model.Inquiry;
import com.project.model.Recipe;
import com.project.model.User;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class AdminService {

    private final AdminMapper adminMapper;

    // 🔹 관리자 - 전체 회원 목록 조회
    public List<User> getAllUsers() {
        return adminMapper.getAllUsers();
    }

    // 🔹 관리자 - 회원 삭제
    public void deleteUser(Long id) {
        adminMapper.deleteUser(id);
    }

    // 🔹 관리자 - 전체 1:1 문의 목록 조회
    public List<Inquiry> getAllInquiries() {
        return adminMapper.getAllInquiries();
    }

    // 🔹 관리자 - 특정 1:1 문의 답변 등록
    public void replyInquiry(Long id, String reply) {
        adminMapper.replyInquiry(id, reply);
    }

    // 🔹 관리자 - 특정 1:1 문의 삭제
    public void deleteInquiry(Long id) {
        adminMapper.deleteInquiry(id);
    }

    // 🔹 관리자 - 레시피 목록 조회
    public List<Recipe> getAllRecipes() {
        return adminMapper.getAllRecipes();
    }

    // 🔹 관리자 - 레시피 등록
    public void insertRecipe(Recipe recipe) {
        adminMapper.insertRecipe(recipe);
    }

    // 🔹 관리자 - 레시피 수정
    public void updateRecipe(Recipe recipe) {
        adminMapper.updateRecipe(recipe);
    }

    // 🔹 관리자 - 레시피 삭제
    public void deleteRecipe(Long id) {
        adminMapper.deleteRecipe(id);
    }

    // 🔹 관리자 - 공모전 승인
    public void approvePost(Long id) {
        adminMapper.approvePost(id);
    }

    // 🔹 관리자 - 공모전 거절
    public void rejectPost(Long id) {
        adminMapper.rejectPost(id);
    }

    // 🔹 관리자 - 게시글 삭제
    public void deletePost(Long id) {
        adminMapper.deletePost(id);
    }

    // 🔹 관리자 - 알림 목록 조회
    public List<String> getNotifications() {
        return adminMapper.getNotifications();
    }

    // 🔹 관리자 - 알림 읽음 처리
    public void markNotificationAsRead(Long id) {
        adminMapper.markNotificationAsRead(id);
    }
    // 🔹 탈퇴 요청 목록 조회 (관리자)
    public List<User> getDeletionRequests() {
        return adminMapper.getDeletionRequests();
    }

    // 🔹 탈퇴 승인 후 계정 삭제 (관리자)
    public void approveAccountDeletion(Long userId) {
        adminMapper.deleteUser(userId);
    }
}
