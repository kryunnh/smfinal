package com.project.service;

import org.springframework.stereotype.Service;

import com.project.mapper.RecipeMapper;
import com.project.model.Recipe;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class RecipeService {

    private final RecipeMapper recipeMapper;

    // 🔹 레시피 - 상세 조회
    public Recipe getRecipeById(Long id) {
        return recipeMapper.getRecipeById(id);
    }

    // 🔹 레시피 - 타로 카드 선택별 추천
    public String getTarotRecommendation(Long cardId) {
        return recipeMapper.getTarotRecommendation(cardId);
    }
}
