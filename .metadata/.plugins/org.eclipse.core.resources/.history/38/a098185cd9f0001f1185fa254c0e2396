package com.project.mapper;

import java.util.List;

import org.apache.ibatis.annotations.Delete;
import org.apache.ibatis.annotations.Insert;
import org.apache.ibatis.annotations.Mapper;
import org.apache.ibatis.annotations.Param;
import org.apache.ibatis.annotations.Select;
import org.apache.ibatis.annotations.Update;

import com.project.model.Inquiry;
import com.project.model.Notification;
import com.project.model.Recipe;
import com.project.model.User;

@Mapper
public interface AdminMapper {

    // 🔹 관리자 - 전체 회원 목록 조회
    @Select("SELECT * FROM users")
    List<User> getAllUsers();

    // 🔹 관리자 - 회원 삭제
    @Delete("DELETE FROM users WHERE id = #{id}")
    void deleteUser(Long id);
    // 🔹 탈퇴 요청 목록 조회 (관리자)
    @Select("SELECT u.* FROM users u JOIN deletion_requests d ON u.email = d.email")
    List<User> getDeletionRequests();

    // 🔹 회원 삭제 (탈퇴 승인 & 임의 삭제)
    @Delete("DELETE FROM users WHERE email = #{email}")
    void deleteUserByEmail(String email);
    
    // 🔹 관리자 - 1:1 문의 전체 목록 조회
    @Select("SELECT * FROM inquiries")
    List<Inquiry> getAllInquiries();

    // 🔹 관리자 - 특정 1:1 문의 답변 등록
    @Update("UPDATE inquiries SET reply = #{reply}, replied_at = NOW() WHERE id = #{id}")
    void replyInquiry(@Param("id") Long id, @Param("reply") String reply);

    // 🔹 관리자 - 특정 1:1 문의 삭제
    @Delete("DELETE FROM inquiries WHERE id = #{id}")
    void deleteInquiry(Long id);
    // 🔹 특정 유저에게 알림 저장
    @Insert("INSERT INTO notifications (user_id, message, sent_at) VALUES (#{userId}, #{message}, NOW())")
    void insertNotification(Notification notification);
    // 🔹 관리자 - 레시피 목록 조회
    @Select("SELECT * FROM recipes")
    List<Recipe> getAllRecipes();

    // 🔹 관리자 - 레시피 등록
    @Insert("INSERT INTO recipes (title, content, image_url) VALUES (#{title}, #{content}, #{imageUrl})")
    void insertRecipe(Recipe recipe);

    // 🔹 관리자 - 레시피 수정
    @Update("UPDATE recipes SET title = #{title}, content = #{content}, image_url = #{imageUrl} WHERE id = #{id}")
    void updateRecipe(Recipe recipe);

    // 🔹 관리자 - 레시피 삭제
    @Delete("DELETE FROM recipes WHERE id = #{id}")
    void deleteRecipe(Long id);

    // 🔹 관리자 - 공모전 승인
    @Update("UPDATE posts SET status = 'APPROVED' WHERE id = #{id}")
    void approvePost(Long id);

    // 🔹 관리자 - 공모전 거절
    @Update("UPDATE posts SET status = 'REJECTED' WHERE id = #{id}")
    void rejectPost(Long id);

    // 🔹 관리자 - 게시글 삭제
    @Delete("DELETE FROM posts WHERE id = #{id}")
    void deletePost(Long id);

    // 🔹 관리자 - 알림 목록 조회
    @Select("SELECT * FROM notifications WHERE role = 'ADMIN'")
    List<String> getNotifications();

    // 🔹 관리자 - 알림 읽음 처리
    @Update("UPDATE notifications SET read_status = 1 WHERE id = #{id}")
    void markNotificationAsRead(Long id);
}
